              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "javascript",
                  "code": "const p = Promise.resolve(42);\np.then(console.log);",
                  "explanation": "Handles a resolved Promise."
                }
              ]
            },
            {
              "title": "async / await",
              "summary": "Write Promise-based workflows with sequential-looking syntax.",
              "signature": "async function f() { await promise; }",
              "definition": "Write Promise-based workflows with sequential-looking syntax.",
              "mental_model": "await pauses the async function, not the whole thread/event loop.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "javascript",
                  "code": "async function run() {\n  const value = await Promise.resolve(42);\n  console.log(value);\n}\nrun();",
                  "explanation": "Awaits an asynchronous value."
                }
              ]
            },
            {
              "title": "ES modules",
              "summary": "Split code using export and import declarations.",
              "signature": "export ... / import ... from ...",
              "definition": "Split code using export and import declarations.",
