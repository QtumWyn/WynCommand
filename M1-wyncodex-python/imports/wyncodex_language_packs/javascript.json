          "description": "Bindings, values, functions, and object syntax.",
          "entries": [
            {
              "title": "let and const",
              "summary": "Declare block-scoped bindings; prefer const when rebinding is unnecessary.",
              "signature": "const x = ... / let x = ...",
              "definition": "Declare block-scoped bindings; prefer const when rebinding is unnecessary.",
              "mental_model": "const locks the binding, not necessarily the object internals.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "javascript",
                  "code": "const app = \"WynCodex\";\nlet count = 0;\ncount += 1;",
                  "explanation": "Declares immutable-binding and mutable-binding names."
                }
              ]
            },
            {
              "title": "Objects",
              "summary": "Store keyed properties on object values.",
              "signature": "{ key: value }",
              "definition": "Store keyed properties on object values.",
