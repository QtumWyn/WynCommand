                  "code": "const langs = [\"JavaScript\", \"Rust\"];\nlangs.push(\"Lua\");",
                  "explanation": "Appends another item."
                }
              ]
            },
            {
              "title": "Functions",
              "summary": "Define reusable callable behavior.",
