              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "javascript",
                  "code": "const text = JSON.stringify({ mode: \"merge\" }, null, 2);\nconsole.log(JSON.parse(text).mode);",
                  "explanation": "Round-trips a simple object."
                }
              ]
            }
