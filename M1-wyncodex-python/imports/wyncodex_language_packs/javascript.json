        {
          "name": "Async and Modules",
          "description": "Promises, async/await, imports, and errors.",
          "entries": [
            {
              "title": "Promises",
              "summary": "Represent a future asynchronous completion or failure.",
              "signature": "Promise<T>",
              "definition": "Represent a future asynchronous completion or failure.",
