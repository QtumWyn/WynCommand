              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "javascript",
                  "code": "try {\n  JSON.parse(\"not json\");\n} catch (err) {\n  console.error(err.message);\n}",
                  "explanation": "Handles invalid JSON."
