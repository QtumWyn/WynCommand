              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "String label = switch (mode) {\n    case STRICT -> \"Strict\";\n    case MERGE -> \"Merge\";\n};",
                  "explanation": "Produces a value from switch."
