        {
          "name": "Concurrency and JVM Tooling",
          "description": "Threads, tasks, and project/build concepts.",
          "entries": [
            {
              "title": "ExecutorService",
              "summary": "Run tasks using managed thread pools.",
              "signature": "Executors.newFixedThreadPool(n)",
              "definition": "Run tasks using managed thread pools.",
              "mental_model": "Separate task submission from thread management.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "try (var pool = java.util.concurrent.Executors.newFixedThreadPool(2)) {\n    pool.submit(() -> System.out.println(\"task\"));\n}",
                  "explanation": "Submits work to a pool."
                }
              ]
            },
            {
              "title": "CompletableFuture",
              "summary": "Compose asynchronous operations and continuations.",
              "signature": "CompletableFuture.supplyAsync(...)",
