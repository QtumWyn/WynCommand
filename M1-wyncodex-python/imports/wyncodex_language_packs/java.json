              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "var f = java.util.concurrent.CompletableFuture.supplyAsync(() -> 21)\n        .thenApply(x -> x * 2);\nSystem.out.println(f.join());",
                  "explanation": "Produces 42 asynchronously."
                }
              ]
            },
