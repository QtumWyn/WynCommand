        {
          "name": "Errors, Files, and Processes",
          "description": "Robust I/O and external command execution.",
          "entries": [
            {
              "title": "Exceptions",
              "summary": "Represent and propagate exceptional failures.",
              "signature": "try { ... } catch (...) { ... }",
              "definition": "Represent and propagate exceptional failures.",
              "mental_model": "Exceptions unwind the call stack until a matching handler appears.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "try {\n    Integer.parseInt(\"bat\");\n} catch (NumberFormatException ex) {\n    System.out.println(\"bad number\");\n}",
                  "explanation": "Handles a parse failure."
                }
              ]
            },
            {
              "title": "try-with-resources",
              "summary": "Automatically close AutoCloseable resources.",
              "signature": "try (Resource r = ...) { ... }",
              "definition": "Automatically close AutoCloseable resources.",
              "mental_model": "Resource lifetime is tied to the lexical block.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "try (var lines = Files.lines(Path.of(\"README.md\"))) {\n    System.out.println(lines.count());\n}",
                  "explanation": "Closes the stream automatically."
                }
              ]
            },
            {
              "title": "Path and Files",
              "summary": "Use java.nio.file for platform-aware filesystem operations.",
              "signature": "Path.of(...) / Files.*",
              "definition": "Use java.nio.file for platform-aware filesystem operations.",
              "mental_model": "Path models location; Files performs operations.",
              "return_value": null,
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "Path path = Path.of(\"packs\", \"java.json\");\nString text = Files.readString(path);",
                  "explanation": "Reads a text file."
                }
              ]
            },
            {
              "title": "ProcessBuilder",
              "summary": "Launch external programs with explicit arguments and I/O behavior.",
              "signature": "new ProcessBuilder(args)",
              "definition": "Launch external programs with explicit arguments and I/O behavior.",
              "mental_model": "Build a child-process configuration, then start it.",
              "return_value": "Process",
              "gotchas": null,
              "notes": null,
              "arguments": [],
              "examples": [
                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "Process p = new ProcessBuilder(\"git\", \"status\", \"--short\")\n        .inheritIO()\n        .start();\nint code = p.waitFor();",
                  "explanation": "Runs git status and waits for completion."
                }
              ]
            }
