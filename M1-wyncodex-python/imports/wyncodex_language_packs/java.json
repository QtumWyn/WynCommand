                {
                  "title": "Example",
                  "type": "practical",
                  "syntax": "java",
                  "code": "class Repo {\n    private final String path;\n    Repo(String path) { this.path = path; }\n}",
                  "explanation": "Defines a small Repo type."
                }
              ]
            },
            {
              "title": "Interfaces",
              "summary": "Define behavioral contracts that classes can implement.",
